    // csharp
    void ShuffleQuestions()
    {
        var rnd = new Random();

        questions = questions
            .OrderBy(_ => rnd.Next())
            .Select(q => new QuizQuestion
            {
                Question = q.Question,
                CorrectAnswer = q.CorrectAnswer,
                CorrectAnswers = q.CorrectAnswers.Count > 0
                    ? q.CorrectAnswers.ToList()
                    : (!string.IsNullOrWhiteSpace(q.CorrectAnswer) ? new List<string> { q.CorrectAnswer } : new List<string>()),
                Answers = q.Answers.OrderBy(_ => rnd.Next()).ToList(),
                IsTextAnswer = q.IsTextAnswer,
                CodeSnippet = q.CodeSnippet,
                Keywords = q.Keywords.ToList()
            })
            .Take(totalQuestions)
            .ToList();
    }


