@page "/quiz/oopadvanced/testdugga"

<div style="
     min-height: 90vh;
     display: flex;
     flex-direction: column;
     align-items: center;
     padding-top: 1rem;">

    <!-- Topic -->
    <MudText Typo="Typo.h1" Align="Align.Center" Class="mb-1">
        Test-dugga
    </MudText>
    <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-4" Color="Color.Secondary">
        Maxpoäng: 42p &nbsp;|&nbsp; Godkänt: 25p (60%)
    </MudText>

    @if (!showResult)
    {
        <!-- Progress -->
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">
            Fråga @(currentQuestion + 1) / @questions.Count
        </MudText>

        <!-- Section badge -->
        <MudChip T="string" Color="Color.Info" Class="mb-3" Style="font-weight:700; font-size:1rem;">
            @questions[currentQuestion].Section &nbsp;– @questions[currentQuestion].Points p
        </MudChip>

        <!-- Question card -->
        <MudCard Class="p-4" Style="max-width:650px; width:100%; margin:0.5rem auto; text-align:center; background-color:transparent">

            <MudText Typo="Typo.h5" Class="mb-2" Style="font-weight:700;">
                @questions[currentQuestion].Question
            </MudText>

            @if (!string.IsNullOrWhiteSpace(questions[currentQuestion].CodeSnippet))
            {
                <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1" Color="Color.Info">Exempel:</MudText>
                <MudPaper Class="pa-3 mb-3" Elevation="4"
                          Style="background:#020617;color:#e5e7eb;font-family:'JetBrains Mono',monospace;font-size:0.85rem;text-align:left;border-radius:12px;overflow-x:auto;">
                    <pre class="code-block">@((MarkupString)System.Net.WebUtility.HtmlEncode(questions[currentQuestion].CodeSnippet ?? ""))</pre>
                </MudPaper>
            }

            <!-- Instruction label -->
            <MudText Typo="Typo.subtitle2" Class="mb-3"
                     Style="font-weight:600;color:#00bfff;text-shadow:0 0 6px rgba(0,150,255,0.8),0 0 12px rgba(0,120,255,0.6);">
                @(questions[currentQuestion].IsTextAnswer
                    ? "Skriv ditt svar (2 av nyckelorden ger poäng)"
                    : questions[currentQuestion].IsMultiChoice
                        ? "Välj alla som stämmer"
                        : "Välj ett svar")
            </MudText>

            <!-- Text answer -->
            @if (questions[currentQuestion].IsTextAnswer)
            {
                <MudTextField @bind-Value="textAnswer"
                              Placeholder="Skriv här (1–3 meningar)"
                              Variant="Variant.Filled"
                              Lines="4"
                              Class="mt-3"
                              Style="width:100%;max-width:620px;" />
            }
            else
            {
                <MudGrid Justify="Justify.Center" Spacing="2">
                    @foreach (var answer in questions[currentQuestion].Answers)
                    {
                        var ans = answer;
                        <MudItem xs="6" Class="d-flex justify-center" @key="ans">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Class="@GetButtonClass(ans)"
                                       OnClick="@(() => SelectAnswer(ans))"
                                       Disabled="@answered"
                                       Style="width:220px;height:70px;font-size:1rem;font-weight:600;border-radius:16px;">
                                @ans
                            </MudButton>
                        </MudItem>
                    }
                </MudGrid>
            }

            <!-- Submit for multi / text -->
            @if (questions[currentQuestion].IsMultiChoice || questions[currentQuestion].IsTextAnswer)
            {
                <MudButton Class="mt-4 submit-glow"
                           Variant="Variant.Filled"
                           Color="Color.Inherit"
                           Disabled="@(answered ||
                                      (questions[currentQuestion].IsMultiChoice && selectedAnswers.Count == 0) ||
                                      (questions[currentQuestion].IsTextAnswer && string.IsNullOrWhiteSpace(textAnswer)))"
                           OnClick="SubmitAnswer">
                    Submit Answer
                </MudButton>
            }

            <!-- Feedback -->
            @if (answered)
            {
                <MudText Typo="Typo.h6" Class="mt-3" Color="@feedbackColor">
                    @feedbackMessage
                </MudText>

                <MudButton Class="mt-3"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="NextQuestion"
                           Style="width:180px;height:50px;font-size:1rem;font-weight:700;border-radius:20px;">
                    @(currentQuestion < questions.Count - 1 ? "Nästa fråga" : "Se resultat")
                </MudButton>
            }

        </MudCard>

        <!-- Running score -->
        <MudText Typo="Typo.subtitle1" Class="mt-4">
            Poäng hittills: @totalScore / @MaxPoints
        </MudText>
    }
    else
    {
        <!-- ===== RESULT SCREEN ===== -->
        <MudCard Class="p-6 mt-4" Style="max-width:560px;width:100%;text-align:center;background-color:transparent">

            @if (Passed)
            {
                <MudText Typo="Typo.h2" Style="color:#00ff88;text-shadow:0 0 12px rgba(0,255,136,0.8);">
                    ✅ Godkänd!
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.h2" Style="color:#ff4444;text-shadow:0 0 12px rgba(255,68,68,0.8);">
                    ❌ Underkänd
                </MudText>
            }

            <MudText Typo="Typo.h4" Class="mt-3">
                Totalpoäng: @totalScore / @MaxPoints
            </MudText>
            <MudText Typo="Typo.h6" Class="mt-1" Color="Color.Secondary">
                Gräns för godkänt: @PassScore p (60%)
            </MudText>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.subtitle1" Style="font-weight:700;" Class="mb-2">Resultat per del</MudText>

            <MudSimpleTable Dense="true" Striped="true" Style="max-width:420px;margin:0 auto;">
                <thead>
                    <tr><th>Del</th><th>Poäng</th><th>Max</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Del A – Teoretiska frågor</td>
                        <td>@sectionScores["Del A"]</td>
                        <td>@sectionMax["Del A"]</td>
                    </tr>
                    <tr>
                        <td>Del B – Kod &amp; resonemang</td>
                        <td>@sectionScores["Del B"]</td>
                        <td>@sectionMax["Del B"]</td>
                    </tr>
                    <tr>
                        <td>Del C – Fritext</td>
                        <td>@sectionScores["Del C"]</td>
                        <td>@sectionMax["Del C"]</td>
                    </tr>
                </tbody>
            </MudSimpleTable>

            <MudButton Class="mt-6" Variant="Variant.Filled" Color="Color.Primary" OnClick="RestartQuiz">
                Försök igen
            </MudButton>

        </MudCard>
    }

</div>

<!-- Copyright -->
<div style="margin-top:auto;padding-bottom:16px;width:100%;display:flex;justify-content:center;text-align:center;">
    <MudText Typo="Typo.caption" Color="Color.Secondary">
        © 2026 FindingTheCode. All rights reserved.
    </MudText>
</div>

@code {

    string textAnswer = "";
    HashSet<string> selectedAnswers = new(StringComparer.OrdinalIgnoreCase);
    int currentQuestion = 0;
    int totalScore = 0;
    bool answered = false;
    bool showResult = false;
    string feedbackMessage = "";
    Color feedbackColor = Color.Default;

    const int MaxPoints = 42;
    const int PassScore = 25; // 60% av 42 ≈ 25p

    bool Passed => totalScore >= PassScore;

    Dictionary<string, int> sectionScores = new() { ["Del A"] = 0, ["Del B"] = 0, ["Del C"] = 0 };
    Dictionary<string, int> sectionMax    = new() { ["Del A"] = 0, ["Del B"] = 0, ["Del C"] = 0 };

    // ── Questions ─────────────────────────────────────────────────────
    List<QuizQuestion> questions = new()
    {
        // ═══ DEL A – Teoretiska frågor (4 × 3p = 12p) ════════════════

        new QuizQuestion
        {
            Section = "Del A", Points = 3,
            Question = "Del A – Flervalsfråga (3p): Rendering – när triggas en omrendering automatiskt i Blazor? (Välj 3)",
            Answers = new() { "När state ändras i en event handler", "När StateHasChanged() anropas", "När en async lifecycle-metod slutförs", "När DOM ändras direkt via JavaScript", "Endast vid sidladdning" },
            CorrectAnswers = new() { "När state ändras i en event handler", "När StateHasChanged() anropas", "När en async lifecycle-metod slutförs" }
        },

        new QuizQuestion
        {
            Section = "Del A", Points = 3,
            Question = "Del A – Flervalsfråga (3p): Dependency Injection – varför registreras en state-container ofta som Scoped? (Välj 3)",
            Answers = new() { "En instans per användarsession", "Delas mellan komponenter i samma circuit", "För att undvika global statisk state", "För att skapa ny instans varje render", "För bättre DOM-prestanda" },
            CorrectAnswers = new() { "En instans per användarsession", "Delas mellan komponenter i samma circuit", "För att undvika global statisk state" }
        },

        new QuizQuestion
        {
            Section = "Del A", Points = 3,
            Question = "Del A – Flervalsfråga (3p): Async i Blazor – varför ska man undvika async void? (Välj 3)",
            Answers = new() { "Felhantering fungerar sämre", "Kan orsaka oobserverade exceptions", "Går inte att await:a", "Ger bättre prestanda", "Blockerar UI-tråden" },
            CorrectAnswers = new() { "Felhantering fungerar sämre", "Kan orsaka oobserverade exceptions", "Går inte att await:a" }
        },

        new QuizQuestion
        {
            Section = "Del A", Points = 3,
            Question = "Del A – Flervalsfråga (3p): State-flöde – vilken modell är korrekt? (Välj 2)",
            Answers = new() { "UI styr state direkt via DOM-manipulation", "State → Render → UI", "UI → Render → State", "Event → State change → Render", "Render → Event → State" },
            CorrectAnswers = new() { "State → Render → UI", "Event → State change → Render" }
        },

        // ═══ DEL B – Kod & resonemang (7 frågor = 22p) ════════════════

        new QuizQuestion
        {
            Section = "Del B", Points = 3,
            Question = "Del B – Flervalsfråga (3p): Autentisering vs Auktorisering – vad stämmer? (Välj 3)",
            Answers = new() { "Autentisering verifierar identitet", "Auktorisering avgör rättigheter", "Authorize-attribut skyddar backend-resurser", "UI-gating ersätter API-skydd", "401 betyder saknar rätt roll" },
            CorrectAnswers = new() { "Autentisering verifierar identitet", "Auktorisering avgör rättigheter", "Authorize-attribut skyddar backend-resurser" }
        },

        new QuizQuestion
        {
            Section = "Del B", Points = 3,
            Question = "Del B – Flervalsfråga (3p): Parameter-flöde – vad är korrekt om [Parameter] i ett child? (Välj 3)",
            Answers = new() { "Sätts av föräldern", "Bör behandlas som read-only i child", "Kan trigga OnParametersSetAsync", "Ska ändras direkt i barnet", "Kräver JS-interop" },
            CorrectAnswers = new() { "Sätts av föräldern", "Bör behandlas som read-only i child", "Kan trigga OnParametersSetAsync" }
        },

        new QuizQuestion
        {
            Section = "Del B", Points = 3,
            Question = "Del B – Flervalsfråga (3p): Code review – varför är review viktig i team? (Välj 3)",
            Answers = new() { "Minskar buggar", "Sprider kunskap i teamet", "Upptäcker arkitekturproblem", "Ersätter tester", "Snabbar upp merge-konflikter" },
            CorrectAnswers = new() { "Minskar buggar", "Sprider kunskap i teamet", "Upptäcker arkitekturproblem" }
        },

        new QuizQuestion
        {
            Section = "Del B", Points = 4,
            Question = "Del B – Flervalsfråga (4p): HTTP-statuskoder – vad är korrekt? (Välj 3)",
            Answers = new() { "200 = OK", "401 = Ej inloggad", "403 = Saknar behörighet", "500 = Valideringsfel", "404 = Fel lösenord" },
            CorrectAnswers = new() { "200 = OK", "401 = Ej inloggad", "403 = Saknar behörighet" }
        },

        new QuizQuestion
        {
            Section = "Del B", Points = 4,
            Question = "Del B – Flervalsfråga (4p): Blazor lifecycle-metoder – vad stämmer? (Välj 3)",
            Answers = new() { "OnInitializedAsync körs en gång vid komponentstart", "OnParametersSetAsync körs när parametrar uppdateras", "OnAfterRenderAsync körs efter varje render", "Dispose körs automatiskt när sidan laddas", "SetParametersAsync kan inte overridas" },
            CorrectAnswers = new() { "OnInitializedAsync körs en gång vid komponentstart", "OnParametersSetAsync körs när parametrar uppdateras", "OnAfterRenderAsync körs efter varje render" }
        },

        new QuizQuestion
        {
            Section = "Del B", Points = 2,
            Question = "Del B – Enkelval (2p): Vilken DI-livstid skapar en ny instans vid varje request/anrop?",
            Answers = new() { "Singleton", "Scoped", "Transient", "Cached" },
            CorrectAnswer = "Transient"
        },

        new QuizQuestion
        {
            Section = "Del B", Points = 3,
            Question = "Del B – Flervalsfråga (3p): Rätt mönster för delad state med notifiering i Blazor? (Välj 3)",
            Answers = new() { "Scoped tjänst i DI som äger state", "StateChanged-event som komponenter prenumererar på", "Prenumerera i OnInitialized och avregistrera i Dispose", "Använd Singleton för delad state i WASM", "Anropa StateHasChanged() direkt i tjänsten" },
            CorrectAnswers = new() { "Scoped tjänst i DI som äger state", "StateChanged-event som komponenter prenumererar på", "Prenumerera i OnInitialized och avregistrera i Dispose" }
        },

        // ═══ DEL C – Fritext (2 × 4p = 8p) ═══════════════════════════

        new QuizQuestion
        {
            Section = "Del C", Points = 4,
            IsTextAnswer = true,
            Question = "Del C – Fritext (4p): Förklara varför komposition minskar koppling. Nämn minst 2 nyckelbegrepp.",
            Keywords = new() { "interface", "abstraktion", "utbytbar", "lös koppling", "implementation", "beroende", "inkapsling" }
        },

        new QuizQuestion
        {
            Section = "Del C", Points = 4,
            IsTextAnswer = true,
            Question = "Del C – Fritext (4p): Förklara hur state styr rendering i Blazor. Nämn minst 2 nyckelbegrepp.",
            Keywords = new() { "state", "render", "statehaschanged", "event", "lifecycle", "omrendering", "uppdatering" }
        },
    };

    // ── Lifecycle ─────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        BuildSectionMax();
    }

    void BuildSectionMax()
    {
        sectionMax["Del A"] = 0; sectionMax["Del B"] = 0; sectionMax["Del C"] = 0;
        foreach (var q in questions)
        {
            var sec = q.Section ?? "Del A";
            if (sectionMax.ContainsKey(sec)) sectionMax[sec] += q.Points;
        }
    }

    // ── Answer logic ──────────────────────────────────────────────────
    void SelectAnswer(string answer)
    {
        if (answered) return;
        var question = questions[currentQuestion];

        if (!question.IsMultiChoice)
        {
            selectedAnswers.Clear();
            selectedAnswers.Add(answer);
            SubmitAnswer();
            return;
        }

        if (selectedAnswers.Contains(answer)) selectedAnswers.Remove(answer);
        else selectedAnswers.Add(answer);
        StateHasChanged();
    }

    void SubmitAnswer()
    {
        answered = true;
        var question = questions[currentQuestion];
        var sec = question.Section ?? "Del A";

        if (question.IsTextAnswer)
        {
            var input = textAnswer?.ToLowerInvariant() ?? "";
            int hits = question.Keywords?.Count(k => input.Contains((k ?? "").ToLowerInvariant())) ?? 0;
            bool ok = hits >= 2;
            if (ok)
            {
                totalScore += question.Points;
                sectionScores[sec] += question.Points;
                feedbackMessage = $"Bra svar! +{question.Points}p ✅";
                feedbackColor = Color.Success;
            }
            else
            {
                feedbackMessage = "För kort / saknar viktiga begrepp ❌ +0p";
                feedbackColor = Color.Error;
            }
            return;
        }

        var correctSet = GetCorrectSet(question);
        bool isCorrect = selectedAnswers.Count == correctSet.Count && selectedAnswers.All(a => correctSet.Contains(a));

        if (isCorrect)
        {
            totalScore += question.Points;
            sectionScores[sec] += question.Points;
            feedbackMessage = $"Rätt! +{question.Points}p 🎉";
            feedbackColor = Color.Success;
        }
        else
        {
            feedbackMessage = $"Fel 😢 +0p  |  Rätt: {string.Join(", ", correctSet)}";
            feedbackColor = Color.Error;
        }
    }

    void NextQuestion()
    {
        answered = false;
        feedbackMessage = "";
        selectedAnswers.Clear();
        textAnswer = "";

        if (currentQuestion < questions.Count - 1) currentQuestion++;
        else showResult = true;
    }

    void RestartQuiz()
    {
        currentQuestion = 0;
        totalScore = 0;
        showResult = false;
        answered = false;
        feedbackMessage = "";
        selectedAnswers.Clear();
        textAnswer = "";
        sectionScores = new() { ["Del A"] = 0, ["Del B"] = 0, ["Del C"] = 0 };
    }

    string GetButtonClass(string answer)
    {
        if (!answered)
            return selectedAnswers.Contains(answer) ? "glow-button glow-preselect" : "glow-button";

        var correct = GetCorrectSet(questions[currentQuestion]);
        if (correct.Contains(answer)) return "glow-button glow-selected";
        if (selectedAnswers.Contains(answer)) return "glow-button glow-wrong";
        return "glow-button";
    }

    HashSet<string> GetCorrectSet(QuizQuestion q)
    {
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (q == null) return set;
        if (q.CorrectAnswers != null && q.CorrectAnswers.Count > 0)
            foreach (var a in q.CorrectAnswers) set.Add(a);
        else if (!string.IsNullOrWhiteSpace(q.CorrectAnswer))
            set.Add(q.CorrectAnswer);
        return set;
    }
}
